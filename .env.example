# =============================================================================
# .env.example — Amazon Deals Bot
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env com segredos reais no Git.
# =============================================================================

# ---------------------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL)
# O primeiro URL é usado pela aplicação (async). O segundo pelo Alembic (sync).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://deals:deals@postgres:5432/deals
DATABASE_SYNC_URL=postgresql+psycopg2://deals:deals@postgres:5432/deals

# Credenciais do container PostgreSQL (usadas no docker-compose.yml)
POSTGRES_DB=deals
POSTGRES_USER=deals
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# REDIS
# Usado para deduplicação de deals e controle de rate limit do WhatsApp.
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# AMAZON PA-API
# Acesse: https://affiliate-program.amazon.com → Tools → Product Advertising API
# Associate Tag: seu ID de afiliado (ex: meusite-20)
# ---------------------------------------------------------------------------
AMAZON_PA_API_ACCESS_KEY=
AMAZON_PA_API_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=
AMAZON_MARKETPLACE=www.amazon.com.br

# ---------------------------------------------------------------------------
# SHOPEE AFFILIATES
# Acesse: https://affiliate.shopee.com.br → Conta → API
# ---------------------------------------------------------------------------
SHOPEE_APP_ID=
SHOPEE_SECRET=

# ---------------------------------------------------------------------------
# MAGALU PARCEIROS
# Acesse: https://parceiros.magazineluiza.com.br
# ---------------------------------------------------------------------------
MAGALU_TOKEN=

# ---------------------------------------------------------------------------
# OPENAI
# Acesse: https://platform.openai.com/api-keys
# MAX_TOKENS: controla o tamanho máximo da copy gerada (recomendado: 150-250)
# TEMPERATURE: criatividade do texto (0.7-0.9 é o ideal para copy)
# DAILY_COST_ALERT_USD: alerta se o custo diário ultrapassar este valor
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=200
OPENAI_TEMPERATURE=0.8
OPENAI_DAILY_COST_ALERT_USD=0.50

# ---------------------------------------------------------------------------
# WHATSAPP — Evolution API
# URL: endereço interno do container (não mude se usar docker-compose)
# API_KEY: senha de acesso à Evolution API — crie uma senha forte
# INSTANCE_NAME: nome da instância (pode ser qualquer nome)
# GROUP_IDS: IDs dos grupos separados por vírgula (ex: 120363xxx@g.us)
#   Para descobrir o ID do grupo, use: GET /group/fetchAllGroups/{instance}
# ---------------------------------------------------------------------------
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=deals-main
WPP_GROUP_IDS=

# Controle de rate limit — IMPORTANTE para não banir o número
# MIN/MAX_INTERVAL: segundos entre mensagens (recomendado: 45-90)
# DAILY_CAP: máximo de mensagens por dia por número (recomendado: 200)
# ACTIVE_HOURS: janela de envio (horário de Brasília, 0-23)
WPP_MIN_INTERVAL_SECONDS=45
WPP_MAX_INTERVAL_SECONDS=90
WPP_DAILY_CAP=200
WPP_ACTIVE_HOURS_START=8
WPP_ACTIVE_HOURS_END=22

# ---------------------------------------------------------------------------
# TELEGRAM
# Bot Token: crie um bot no @BotFather e copie o token
# Channel ID: @nomeDoCanal (público) ou -1001234567890 (privado/numérico)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ---------------------------------------------------------------------------
# ALERTAS — Telegram pessoal do operador
# O bot de alertas envia mensagens direto para o chat do operador.
# Pode ser o mesmo bot do canal ou um bot separado.
# Para descobrir seu CHAT_ID: envie uma mensagem para @userinfobot
# ---------------------------------------------------------------------------
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# DOZZLE — Painel de logs (acesso via navegador na porta 9999)
# Crie um usuário e senha fortes — este painel fica exposto na internet
# ---------------------------------------------------------------------------
DOZZLE_USERNAME=admin
DOZZLE_PASSWORD=

# ---------------------------------------------------------------------------
# SCHEDULER — Frequência de execução das três fases do pipeline
# PHASE1: coleta de deals nas APIs (a cada X minutos)
# COPYWRITER: geração de copy com OpenAI (a cada X segundos)
# PHASE2: envio de mensagens pendentes (a cada X segundos)
# ---------------------------------------------------------------------------
PHASE1_INTERVAL_MINUTES=15
COPYWRITER_INTERVAL_SECONDS=120
PHASE2_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# GERAL
# LOG_LEVEL: INFO (recomendado) | DEBUG (muito verboso) | WARNING (silencioso)
# ENVIRONMENT: production | development
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=production
